# Server-only; include /api/v1, no trailing slash required.
LARAVEL_API_URL=http://127.0.0.1:8000/api/v1
# Browser-facing public storage origin; used for product photos.
NEXT_PUBLIC_MEDIA_ORIGIN=http://127.0.0.1:8000
# Set to the exact externally visible Next.js origin in production.
APP_ORIGIN=http://localhost:3000

# Optional: match your existing Laravel Reverb configuration (public key only).
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=127.0.0.1
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
# Copy only the public VAPID key from Laravel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
