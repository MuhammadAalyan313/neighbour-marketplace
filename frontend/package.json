{
  "name": "neighbour-marketplace",
  "version": "0.2.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "smoke:api": "node --env-file-if-exists=.env.local tests/smoke-api.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "predev": "npm run doctor",
    "prebuild": "npm run doctor",
    "verify": "npm run doctor && npm test && npm run typecheck && npm run build"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "pusher-js": "8.6.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
